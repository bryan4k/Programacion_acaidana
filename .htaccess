Options -Indexes

<FilesMatch "(?i)(^\.|\.(sql|env|ini|log|bak|old|save|dist|example|zip|gz|tgz|tar|7z)$|~$|^README\.md$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
    RewriteRule "(^|/).*(config|database|dump|backup).*" - [F,L,NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ - [F,L]
</IfModule>
